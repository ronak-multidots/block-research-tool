<?xml version="1.0"?>
<ruleset name="Global Store Flash Sale Header">
	<description>WordPress Coding Standards for the Flash Sale Header block.</description>

	<file>.</file>

	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/artifacts/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="ps"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<!-- The plugin uses namespaces and PSR-ish class files under includes/. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="flash-sale-header-block"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="GlobalStore\FlashSaleHeader"/>
				<element value="gsfsh"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WhiteSpace.ControlStructureSpacing">
		<properties>
			<property name="blank_line_check" value="true"/>
		</properties>
	</rule>

	<!--
		Test files follow PHPUnit conventions rather than WordPress file conventions:
		classes are PascalCase, test methods document themselves through their names,
		and the bootstrap writes plain text to the console.
	-->
	<rule ref="Squiz.Commenting.FunctionComment">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>/tests/php/*/bootstrap.php</exclude-pattern>
	</rule>
	<!-- The stubs deliberately mirror what the real WordPress functions do internally. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tests/php/unit/wp-stubs.php</exclude-pattern>
	</rule>
</ruleset>
