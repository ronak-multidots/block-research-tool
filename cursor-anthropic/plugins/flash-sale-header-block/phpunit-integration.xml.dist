<?xml version="1.0" encoding="UTF-8"?>
<!--
	Integration tests that boot the WordPress test suite. Run them with:

	  npm run env:start
	  npx wp-env run tests-cli --env-cwd=wp-content/plugins/flash-sale-header-block \
	    vendor/bin/phpunit --configuration phpunit-integration.xml.dist
-->
<phpunit
	bootstrap="tests/php/integration/bootstrap.php"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	cacheResult="false"
>
	<testsuites>
		<testsuite name="integration">
			<directory suffix="Test.php">tests/php/integration</directory>
		</testsuite>
	</testsuites>
</phpunit>
