<?xml version="1.0" encoding="UTF-8"?>
<!--
	Isolated unit tests. They stub the handful of WordPress functions the sanitiser and
	renderer depend on, so they run anywhere PHP runs - no database, no WordPress install.
-->
<phpunit
	bootstrap="tests/php/unit/bootstrap.php"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	failOnWarning="true"
	failOnRisky="true"
	cacheResult="false"
>
	<testsuites>
		<testsuite name="unit">
			<directory suffix="Test.php">tests/php/unit</directory>
		</testsuite>
	</testsuites>
</phpunit>
